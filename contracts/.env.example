# Utter contracts deploy configuration (EXAMPLE - copy to .env.local).
#
# .env.local is gitignored (see CLAUDE.md: secrets only in .env.local). This
# .env.example carries NO real secrets, only placeholders and documented
# defaults. The deploy script reads these via vm.envOr, so a keyless dry run
# (forge script script/Deploy.s.sol) works with everything unset.

# Arc Testnet RPC. Public, no API key. chainId 5042002.
ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC token address. Defaults to the canonical Arc USDC when unset. This is the
# 6-decimal ERC-20 (also the 18-decimal native gas token); never mix the two.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Platform fee in basis points (out of 10000). Default 3000 = platform 30% /
# creator 70% (spec section 16). The splitter's creatorBps is 10000 - this.
PLATFORM_FEE_BPS=3000

# Address that receives the platform / treasury share. Operator-chosen. Defaults
# to the deployer address when unset.
PLATFORM_TREASURY=

# Relayer / facilitator permitted to submit escrow debits. Defaults to the
# deployer when unset.
ESCROW_ADMIN=

# Ownable owner of the deployed contracts (may rotate admin, pause resources,
# slash bonds). Defaults to the deployer when unset.
CONTRACT_OWNER=

# Deployer EOA private key. REQUIRED for a live --broadcast deploy and must be
# funded with native USDC gas via https://faucet.circle.com. NEVER commit a real
# key. Leave empty here; set it only in .env.local. The dry run falls back to a
# well-known Anvil test key, so a keyless simulation needs no value.
DEPLOYER_PRIVATE_KEY=
