# Utter — environment template. Copy to .env.local (gitignored) and fill in.
# NEVER put real secrets in this file. Real values live only in .env.local.

# Arc Testnet chain reference (SPEC §6, §16)
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_EXPLORER=https://testnet.arcscan.app

# Funded test wallet for pnpm test:chain.
# The Phase 0 balance read needs ONLY the address (read-only).
# The private key is a forward-use placeholder; leave it EMPTY here and set the
# real key only in .env.local. Fund the wallet at https://faucet.circle.com.
TEST_WALLET_ADDRESS=0x...
TEST_WALLET_PRIVATE_KEY=

# Phase 2 payment layer (SPEC §16). Placeholders ONLY here.
# Relayer signer pool for the facilitator /settle path (the escrow admin keys).
# These are real private keys: leave EMPTY here, set the comma-separated list
# ONLY in .env.local (gitignored). Never logged, never committed.
RELAYER_SIGNER_KEYS=
# Funded buyer EOA for the OPERATOR-GATED live money-path E2E
# (packages/x402-arc/examples/echo/live-money-path.ts). Real private key: leave
# EMPTY here, set it ONLY in .env.local (gitignored). Fund both this buyer and the
# RELAYER_SIGNER_KEYS escrow-admin EOA at https://faucet.circle.com. Never committed.
TEST_BUYER_PRIVATE_KEY=
# Base URL the x402-arc middleware calls for /verify /release /settle.
FACILITATOR_URL=http://localhost:8787
# Platform treasury that receives the floored split remainder (bytes20 address).
PLATFORM_TREASURY=0x...
# Platform fee in basis points (e.g. 3000 = 30%); creatorBps = 10000 - this.
PLATFORM_FEE_BPS=3000
# Hard cap on the metered size term and the buffered response body (bytes).
MAX_RESPONSE_BYTES=1048576
# Per-call handler timeout before the gate declares a malfunction (seconds).
RESOURCE_TIMEOUT_SECONDS=30
# Extra window the signed validBefore must outlive the gate by (seconds).
SETTLE_BUFFER_SECONDS=90
# Result retention for GET /results/:idemKey (seconds; default 24h = 86400).
RESULT_TTL_SECONDS=86400
# Real-adapter Postgres + Redis (in-memory is the test default; leave blank for tests).
DATABASE_URL=
REDIS_URL=

# Phase 3 sandbox + deploy layer (SPEC §9.3/§9.5/§16). Placeholders ONLY here.
# The isolation backend. `gvisor` (runsc) is the ONLY trusted security boundary
# and runs on the operator-provisioned host; `docker-dev` is plain Docker for
# local wiring + integration tests and is NOT a security boundary.
SANDBOX_RUNTIME=gvisor
# The data-proxy URL — the ONLY permitted egress from a sandboxed resource. Empty
# locally; the operator sets the provisioned proxy URL.
EGRESS_PROXY_URL=
# HMAC secret for the short-lived resource-scoped JWT the data-proxy mints
# (HS256, aud=resourceId, tight exp). The verifying secret stays on the proxy.
# Real secret: leave EMPTY here, set ONLY in .env.local (gitignored).
DATA_PROXY_TOKEN_SECRET=
# Hard cap on the request body bytes admitted into the sandbox (SBX-04 size cap;
# DISTINCT from MAX_RESPONSE_BYTES which also caps the metered size term).
MAX_REQUEST_BYTES=1048576
# The wildcard deploy domain: resources serve at https://<slug>.resources.<domain>.
# The `*.resources.<domain>` wildcard cert + DNS are operator-provisioned.
DEPLOY_DOMAIN=resources.example.com
# Traefik DNS-01 wildcard-cert provider + API token (operator-provisioned; the
# only ACME challenge that issues a wildcard). Real creds: leave EMPTY here, set
# ONLY in .env.local (gitignored).
DNS_PROVIDER=
DNS_API_TOKEN=
# Internal Verdaccio pull-through npm mirror for the no-network-at-build (SBX-05).
# EMPTY = use the public registry locally (the documented prod-mirror swap). The
# no-network-at-build property holds ONLY once the operator provisions the mirror.
REGISTRY_MIRROR_URL=

# Phase 4 AI generation layer (SPEC §9.2/§16). Placeholders ONLY here.
# Anthropic API key for the operator-gated claude generation backend. Real secret:
# leave EMPTY here, set ONLY in .env.local (gitignored). Empty here means the
# scaffold backend is selected, so the whole autonomous suite runs with no key.
ANTHROPIC_API_KEY=
# OpenAI API key, reserved for a future alternative backend. Real secret: leave
# EMPTY here, set ONLY in .env.local (gitignored).
OPENAI_API_KEY=
# The default model for the claude backend. A non-secret default; the scaffold
# backend ignores it entirely. Operator-overridable.
DEFAULT_MODEL=claude-sonnet-4-6
# Force a generation backend. EMPTY selects scaffold whenever ANTHROPIC_API_KEY is
# also empty; set to `scaffold` to force the deterministic backend even with a key.
AI_RUNTIME_GENERATOR=

# Phase 5 - Verify, Identity, Publish & Trust (SPEC §16). Placeholders ONLY here.
# The three ERC-8004 reference registry addresses. These are pinned into
# packages/chain/src/addresses.ts after the operator-gated CREATE2 deploy; leave
# EMPTY here, set the deployed addresses ONLY in .env.local (gitignored).
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_VALIDATION_REGISTRY=
# Scorer poll interval (ms) and the per-resource scoring latency budget (ms).
# Non-secret operator tunables; empty selects the in-code defaults.
SCORER_INTERVAL_MS=
SCORER_LATENCY_BUDGET_MS=
# AI moderation backend selector. EMPTY selects the deterministic keyword backend
# (mirroring AI_RUNTIME_GENERATOR); set to a backend name to force it.
MODERATION_BACKEND=
# Per-resource data-proxy quota ceilings: calls and response bytes. Non-secret
# operator tunables; empty selects the in-code defaults.
DATA_PROXY_QUOTA_CALLS=
DATA_PROXY_QUOTA_BYTES=
# Registry admin key that broadcasts the operator-gated slash / refund / pause
# transactions. Real private key: leave EMPTY here, set ONLY in .env.local
# (gitignored). Never logged, never committed.
REGISTRY_ADMIN_PRIVATE_KEY=

# Phase 6 Studio + Observability (SPEC §16). Placeholders ONLY here; real values
# in .env.local (gitignored). Reuse ARC_EXPLORER (line 8) for ArcScan TxLinks.
# Signed session-cookie secret for the SIWE httpOnly session (STU-05). Real
# secret: leave EMPTY here, set ONLY in .env.local (gitignored). Never committed.
SESSION_SECRET=
# The EIP-4361 domain the SIWE message is bound to (replay/domain guard). Non-
# secret; the operator sets the deployed Studio domain.
SIWE_DOMAIN=
# The Studio data-adapter backend. `fixture` (the autonomous-safe default the
# selectAdapter invariant relies on; no network/chain/model) or `live` (operator-
# gated, throws RequiresLiveServicesError until provisioned).
STUDIO_DATA_ADAPTER=fixture
# The live alert sink URL the operator-gated AlertSink posts to (OBS-02). Real
# secret/endpoint: leave EMPTY here, set ONLY in .env.local (gitignored). EMPTY
# selects the in-memory test sink.
ALERT_SINK_URL=
# Operator bearer token gating the /metrics Prometheus exposition (WR-03). The
# money-path metric set is NOT world-readable: a scraper must present this token
# as `Authorization: Bearer <token>` (a creator session also authorizes in-app).
# Real secret: leave EMPTY here (an empty value DISABLES the bearer path - it can
# never authorize), set ONLY in .env.local (gitignored). Never logged, never committed.
METRICS_TOKEN=
