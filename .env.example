# Utter — environment template. Copy to .env.local (gitignored) and fill in.
# NEVER put real secrets in this file. Real values live only in .env.local.

# Arc Testnet chain reference (SPEC §6, §16)
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_EXPLORER=https://testnet.arcscan.app

# Funded test wallet for pnpm test:chain.
# The Phase 0 balance read needs ONLY the address (read-only).
# The private key is a forward-use placeholder; leave it EMPTY here and set the
# real key only in .env.local. Fund the wallet at https://faucet.circle.com.
TEST_WALLET_ADDRESS=0x...
TEST_WALLET_PRIVATE_KEY=

# Phase 2 payment layer (SPEC §16). Placeholders ONLY here.
# Relayer signer pool for the facilitator /settle path (the escrow admin keys).
# These are real private keys: leave EMPTY here, set the comma-separated list
# ONLY in .env.local (gitignored). Never logged, never committed.
RELAYER_SIGNER_KEYS=
# Per-resource caller-auth HMAC secret for the facilitator /verify /settle /release
# routes (Security review C1). When SET the routes require a caller token bound to
# the operation's resourceId (a peer cannot forge a strike / replay a release /
# self-settle on a resource it does not own): missing/invalid -> 401, resourceId
# mismatch -> 403. When UNSET in dev/test the routes pass through unchanged (the
# in-process money path stays green). FAIL-CLOSED in production: an unset/blank/
# <32-char value throws at boot. Real secret: leave EMPTY here, set ONLY in
# .env.local (gitignored). Never logged, never committed.
FACILITATOR_AUTH_SECRET=
# Node runtime mode for the facilitator service. Leave UNSET for Phase 1 (the
# trusted in-process echo gate): auth is UNENFORCED so the gate, which presents no
# token yet, passes through the money path. Set to `production` only once the Phase
# 2 sidecar mints + presents per-resource tokens - production REQUIRES a >=32-char
# FACILITATOR_AUTH_SECRET (server.ts fails-fast at boot otherwise).
NODE_ENV=
# Funded buyer EOA for the OPERATOR-GATED live money-path E2E
# (packages/x402-arc/examples/echo/live-money-path.ts). Real private key: leave
# EMPTY here, set it ONLY in .env.local (gitignored). Fund both this buyer and the
# RELAYER_SIGNER_KEYS escrow-admin EOA at https://faucet.circle.com. Never committed.
TEST_BUYER_PRIVATE_KEY=
# The single canonical FACILITATOR_URL, consumed by BOTH roles that read this key:
# the facilitator-side x402-arc middleware that calls /verify /release /settle, and the
# buyer-side client/MCP server that calls /verify /settle /results/:idemKey. Defined
# exactly once so the last definition cannot silently clobber an earlier one in a single
# .env.local. EMPTY selects the in-process facilitator (the autonomous fixture transport);
# set the deployed facilitator base URL for a live target.
FACILITATOR_URL=
# Platform treasury that receives the floored split remainder (bytes20 address).
PLATFORM_TREASURY=0x...
# Platform fee in basis points (e.g. 3000 = 30%); creatorBps = 10000 - this.
PLATFORM_FEE_BPS=3000
# Hard cap on the metered size term and the buffered response body (bytes).
MAX_RESPONSE_BYTES=1048576
# Per-call handler timeout before the gate declares a malfunction (seconds).
RESOURCE_TIMEOUT_SECONDS=30
# Extra window the signed validBefore must outlive the gate by (seconds).
SETTLE_BUFFER_SECONDS=90
# Result retention for GET /results/:idemKey (seconds; default 24h = 86400).
RESULT_TTL_SECONDS=86400
# Real-adapter Postgres + Redis (in-memory is the test default; leave blank for tests).
DATABASE_URL=
REDIS_URL=

# Phase 3 sandbox + deploy layer (SPEC §9.3/§9.5/§16). Placeholders ONLY here.
# The real digest-pinned node base for the resource image build, e.g.
# node:22-bookworm-slim@sha256:<64hex>. Get it on the host via `docker inspect
# --format '{{index .RepoDigests 0}}' node:22-bookworm-slim` after a `docker pull
# node:22-bookworm-slim`. The deploy build (H2) asserts the base is pinned BY
# DIGEST, so this MUST be set on the host. EMPTY here (the digest is host-specific
# and moves; never a committed literal).
DEPLOY_BASE_IMAGE_NODE=
# The isolation backend. `gvisor` (runsc) is the ONLY trusted security boundary
# and runs on the operator-provisioned host; `docker-dev` is plain Docker for
# local wiring + integration tests and is NOT a security boundary.
SANDBOX_RUNTIME=gvisor
# The data-proxy URL — the ONLY permitted egress from a sandboxed resource. Empty
# locally; the operator sets the provisioned proxy URL.
EGRESS_PROXY_URL=
# HMAC secret for the short-lived resource-scoped JWT the data-proxy mints
# (HS256, aud=resourceId, tight exp). The verifying secret stays on the proxy.
# Real secret: leave EMPTY here, set ONLY in .env.local (gitignored).
DATA_PROXY_TOKEN_SECRET=
# Hard cap on the request body bytes admitted into the sandbox (SBX-04 size cap;
# DISTINCT from MAX_RESPONSE_BYTES which also caps the metered size term).
MAX_REQUEST_BYTES=1048576
# The wildcard deploy domain: resources serve at https://<slug>.resources.<domain>.
# The `*.resources.<domain>` wildcard cert + DNS are operator-provisioned.
DEPLOY_DOMAIN=resources.example.com
# Traefik DNS-01 wildcard-cert provider + API token (operator-provisioned; the
# only ACME challenge that issues a wildcard). Real creds: leave EMPTY here, set
# ONLY in .env.local (gitignored).
DNS_PROVIDER=
DNS_API_TOKEN=
# Internal Verdaccio pull-through npm mirror for the no-network-at-build (SBX-05).
# EMPTY = use the public registry locally (the documented prod-mirror swap). The
# no-network-at-build property holds ONLY once the operator provisions the mirror.
REGISTRY_MIRROR_URL=

# Phase 4 AI generation layer (SPEC §9.2/§16). Placeholders ONLY here.
# Anthropic API key for the operator-gated claude generation backend. Real secret:
# leave EMPTY here, set ONLY in .env.local (gitignored). Empty here means the
# scaffold backend is selected, so the whole autonomous suite runs with no key.
ANTHROPIC_API_KEY=
# OpenAI API key, reserved for a future alternative backend. Real secret: leave
# EMPTY here, set ONLY in .env.local (gitignored).
OPENAI_API_KEY=
# The default model for the claude backend. A non-secret default; the scaffold
# backend ignores it entirely. Operator-overridable.
DEFAULT_MODEL=claude-sonnet-4-6
# Force a generation backend. EMPTY selects scaffold whenever ANTHROPIC_API_KEY is
# also empty; set to `scaffold` to force the deterministic backend even with a key.
AI_RUNTIME_GENERATOR=

# Phase 5 - Verify, Identity, Publish & Trust (SPEC §16). Placeholders ONLY here.
# The three ERC-8004 reference registry addresses. These are pinned into
# packages/chain/src/addresses.ts after the operator-gated CREATE2 deploy; leave
# EMPTY here, set the deployed addresses ONLY in .env.local (gitignored).
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_VALIDATION_REGISTRY=
# Scorer poll interval (ms) and the per-resource scoring latency budget (ms).
# Non-secret operator tunables; empty selects the in-code defaults.
SCORER_INTERVAL_MS=
SCORER_LATENCY_BUDGET_MS=
# AI moderation backend selector. EMPTY selects the deterministic keyword backend
# (mirroring AI_RUNTIME_GENERATOR); set to a backend name to force it.
MODERATION_BACKEND=
# Per-resource data-proxy quota ceilings: calls and response bytes. Non-secret
# operator tunables; empty selects the in-code defaults.
DATA_PROXY_QUOTA_CALLS=
DATA_PROXY_QUOTA_BYTES=
# Registry admin key that broadcasts the operator-gated slash / refund / pause
# transactions. The deployer's live-deploy step ALSO consumes this (with
# PLATFORM_TREASURY + PLATFORM_FEE_BPS) to register the deployed resource on-chain
# before any debit fires (register is onlyOwner). Real private key: leave EMPTY
# here, set ONLY in .env.local (gitignored). Never logged, never committed.
REGISTRY_ADMIN_PRIVATE_KEY=
# Optional: split the resource creator identity from the registry admin. When set,
# the deployer registers this address as the resource creator; otherwise the
# creator defaults to the admin address (the collapsed testnet role).
RESOURCE_CREATOR=

# Phase 6 Studio + Observability (SPEC §16). Placeholders ONLY here; real values
# in .env.local (gitignored). Reuse ARC_EXPLORER (line 8) for ArcScan TxLinks.
# Signed session-cookie secret for the SIWE httpOnly session (STU-05). Real
# secret: leave EMPTY here, set ONLY in .env.local (gitignored). Never committed.
SESSION_SECRET=
# The EIP-4361 domain the SIWE message is bound to (replay/domain guard). Non-
# secret; the operator sets the deployed Studio domain.
SIWE_DOMAIN=
# The Studio data-adapter backend. `fixture` (the autonomous-safe default the
# selectAdapter invariant relies on; no network/chain/model) or `live` (operator-
# gated, throws RequiresLiveServicesError until provisioned).
STUDIO_DATA_ADAPTER=fixture
# The marketplace service base URL the studio POSTs a deployed resource to for discovery
# (POST {MARKETPLACE_URL}/resources). EMPTY here disables the marketplace listing (the
# studio keeps its local-index-only Publish stage); set it to the marketplace host the
# studio can reach (e.g. http://marketplace:8789 in compose, or
# http://host.docker.internal:8789). Mirrors DEPLOYER_URL. Non-secret.
MARKETPLACE_URL=
# The shared Bearer the studio presents to the marketplace POST /resources endpoint. It
# MUST match the marketplace service's own MARKETPLACE_AUTH_SECRET. Real secret: leave
# EMPTY here (an empty value disables the marketplace listing), set ONLY in .env.local
# (gitignored). Sent only in the Authorization header; never logged, never committed.
MARKETPLACE_AUTH_SECRET=
# WalletConnect Cloud projectId for the Studio SIWE walletconnect button (client-
# exposed Vite var, so it is VITE_-prefixed and reaches the browser bundle). EMPTY
# here keeps the walletconnect button disabled (injected/metamask still works); get
# a free projectId at https://cloud.walletconnect.com and set it ONLY in .env.local
# to enable the button. Public-ish id, but env-provided, never committed.
VITE_WALLETCONNECT_PROJECT_ID=
# The live alert sink URL the operator-gated AlertSink posts to (OBS-02). Real
# secret/endpoint: leave EMPTY here, set ONLY in .env.local (gitignored). EMPTY
# selects the in-memory test sink.
ALERT_SINK_URL=
# Operator bearer token gating the /metrics Prometheus exposition (WR-03). The
# money-path metric set is NOT world-readable: a scraper must present this token
# as `Authorization: Bearer <token>` (a creator session also authorizes in-app).
# Real secret: leave EMPTY here (an empty value DISABLES the bearer path - it can
# never authorize), set ONLY in .env.local (gitignored). Never logged, never committed.
METRICS_TOKEN=

# Phase 7 buyer SDK + MCP server (SPEC §9.15/§16). Placeholders ONLY here; real
# values in .env.local (gitignored). The buyer SDK signs spend authorizations, so
# the key is high-risk: it is read once server-side, held in the transport, and
# NEVER passed to a tool handler, returned, or logged.
# The buyer wallet private key the MCP server signs DebitAuthorizations with. Real
# private key: leave EMPTY here, set ONLY in .env.local (gitignored). The model
# never sees it; never logged, never committed (T-07-KEYLEAK).
BUYER_PRIVATE_KEY=
# The buyer client also reads FACILITATOR_URL for /verify /settle /results/:idemKey.
# It is defined ONCE in the Phase 2 payment block above (EMPTY = the in-process
# facilitator default, the autonomous fixture transport); no second key here.
# The buyer transport selector. `fixture` (the autonomous-safe default: in-process
# facilitator + mock chain) or `live` (operator-gated, throws RequiresLiveBuyerError
# until a funded buyer EOA + a deployed resource over HTTPS are provisioned).
BUYER_SDK_TRANSPORT=
# Per-tool spend cap in USDC base units (the soft budget guard layered over the
# on-chain signed maxAmount hard cap). Non-secret operator tunable; empty selects
# the in-code default.
MCP_PER_TOOL_CAP_BASE_UNITS=
# Per-day spend cap in USDC base units (the denial-of-wallet guard against an agent
# looping tool calls). Non-secret operator tunable; empty selects the in-code default.
MCP_PER_DAY_CAP_BASE_UNITS=
# The buyer-configured per-call ceiling in WHOLE USDC tokens (NOT base units), enforced
# INDEPENDENT of any card (CR-01 / T-07-OVERCHARGE). A hostile card can advertise an
# arbitrarily large pricing.max; the client clamps the signed maxAmount to
# min(card cap, this ceiling) so it can never sign above what the buyer authorized. The
# value is scaled to base units at runtime via the USDC decimals() read (no base-unit
# literal). Non-secret operator tunable; empty = no buyer ceiling (the card cap stands).
BUYER_MAX_CAP_TOKENS=
# The live marketplace index URL the buyer MCP bin reads for discovery (operator-gated;
# the live BUY-03 demo is provisioned separately). Empty = the live discovery read
# fail-louds (the autonomous suite drives the tool handlers in-process instead).
MARKETPLACE_INDEX_URL=

# Phase 8 scale & extras (SPEC §12; SCL-01..06). Placeholders ONLY here; real values
# in .env.local (gitignored). EVERY value below is intentionally EMPTY: an empty value
# selects the autonomous in-process default, and no live endpoint/secret default is
# ever committed (T-08-SECRET).
#
# SCL-01 orchestration. Driver selector: empty/`local` uses the in-process LocalDriver
# (the autonomous default); `nomad` selects the operator-gated NomadDriver, which throws
# RequiresLiveOrchestrator until a Nomad host is provisioned.
ORCHESTRATOR=
# The Nomad HTTP API endpoint the live NomadDriver schedules against. Empty = no live
# host (the LocalDriver path runs in-process). Operator-provisioned; never a boundary itself.
NOMAD_ENDPOINT=
# Warm-pool size: the number of pre-warmed sandboxes kept ready so first-call-after-idle
# cold-start stays under the escrow timeout budget (Pitfall 8). Empty selects the in-code
# default (> 0). Non-secret operator tunable.
ORCHESTRATOR_WARM_POOL_SIZE=
# Idle-reaper TTL in seconds: how long an idle sandbox lives before scale-to-zero reaps it.
# Empty selects the in-code default. Non-secret operator tunable.
ORCHESTRATOR_IDLE_TTL_SECONDS=
# SCL-03 StableFX live toggle. Empty/`mock` uses the deterministic MockStableFx quote+swap
# (the autonomous default); `live` selects LiveStableFx, which throws RequiresLiveStableFx
# until an off-chain RFQ quote partner is provisioned. StableFX is RFQ; no autonomous live swap.
STABLEFX_MODE=
# SCL-04 CCTP live toggle. Empty/`mock` uses the mock attestation + poll-and-credit default
# (the autonomous path); `live` selects the live CctpFunder, which throws RequiresLiveCctp
# until Circle Iris attestations + a funded cross-chain wallet are provisioned. Domain is 26
# (pinned in @utter/chain CCTP_DOMAIN), never an env literal.
CCTP_MODE=
# SCL-05 per-payer rolling-24h spend cap in USDC base units (the deny-by-default budget guard
# enforced BEFORE /verify reserve + handler). Empty selects the in-code default. Scaled at
# runtime via the USDC decimals() read; never a base-unit literal here. Non-secret tunable.
SPEND_CAP_PER_PAYER_24H_BASE_UNITS=
# SCL-02 min-economical batching threshold in USDC base units. EMPTY by default means
# immediate settle with no batching, exactly as today. Setting it routes sub-threshold
# debits into the per-resource BatchSettler once the operator-provided batch-authorization
# seam is wired. The facilitator reads this var (server.ts buildDepsFromEnv). Non-secret tunable.
MIN_ECONOMICAL_AMOUNT=
# SCL-05 per-resource data-proxy quota default (request/byte budget). Empty selects the in-code
# default. Non-secret operator tunable.
DATA_PROXY_QUOTA_DEFAULT=
# SCL-06 price-floor mode. Empty/`soft` flags a below-floor price without blocking (the default);
# `hard` blocks publishing a resource priced below its cost-plus-margin floor (opt-in). Non-secret tunable.
PRICE_FLOOR_MODE=
